{
  "name": "family-participation-game",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @family-game/web dev",
    "build": "pnpm --filter @family-game/web build",
    "build:sites": "node scripts/build-sites.mjs",
    "typecheck": "pnpm --filter @family-game/web typecheck",
    "test": "vitest run",
    "schema-check": "node scripts/schema-contract-check.mjs",
    "health": "node scripts/project-health.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm schema-check && pnpm health"
  },
  "devDependencies": {
    "vitest": "latest"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
